<Window x:Class="ReservasApp.Views.MenuPrincipalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReservasApp.ViewModels"
        Title="Sistema de Reservas - Menú principal"
        Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">

    <Window.DataContext>
        <vm:MenuPrincipalViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1D2939" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF1FF" />
                    <Setter Property="BorderBrush" Value="#2F6FED" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="10" Margin="24" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.15" />
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Menú principal" FontSize="20" FontWeight="Bold"
                       Foreground="#1D2939" Margin="0,0,0,4" />
            <TextBlock Text="Selecciona una opción" FontSize="12"
                       Foreground="#667085" Margin="0,0,0,20" />

            <Button Content="📋  Aulas (DataTable)"
                    Style="{StaticResource BotonMenu}"
                    Command="{Binding AbrirAulasDataTableCommand}" />

            <Button Content="🏫  Aulas (Objetos)"
                    Style="{StaticResource BotonMenu}"
                    Command="{Binding AbrirAulasObjetosCommand}" />

            <Button Content="📅  Reservas (DataTable)"
                    Style="{StaticResource BotonMenu}"
                    Command="{Binding AbrirReservasDataTableCommand}" />

            <Button Content="🗂️  Reservas (Objetos)"
                    Style="{StaticResource BotonMenu}"
                    Command="{Binding AbrirReservasObjetosCommand}" />

            <Button Content="➕  Nueva Reserva"
                    Style="{StaticResource BotonMenu}"
                    Command="{Binding AbrirNuevaReservaCommand}" />
        </StackPanel>
    </Border>
</Window>
    