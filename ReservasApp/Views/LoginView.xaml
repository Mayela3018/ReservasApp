<Window x:Class="ReservasApp.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReservasApp.ViewModels"
        Title="Iniciar sesión - Sistema de Reservas"
        Height="480" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F2F4F7">

    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="CampoTexto" TargetType="Control">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2F6FED" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#255CC7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="10" Margin="24" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.15" />
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Sistema de Reservas"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#1D2939"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Ingresa tus credenciales para continuar"
                       FontSize="12" Foreground="#667085"
                       HorizontalAlignment="Center" Margin="0,4,0,24" />

            <TextBlock Text="Usuario" FontSize="12" Foreground="#344054" />
            <TextBox x:Name="TxtUsername"
                     Style="{StaticResource CampoTexto}"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Contraseña" FontSize="12" Foreground="#344054" Margin="0,14,0,0" />
            <PasswordBox x:Name="TxtPassword"
                         Style="{StaticResource CampoTexto}" />

            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#D92D20" FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <Button Content="Ingresar"
                    Style="{StaticResource BotonPrimario}"
                    Margin="0,20,0,0"
                    Click="BtnIngresar_Click" />

        </StackPanel>
    </Border>
</Window>